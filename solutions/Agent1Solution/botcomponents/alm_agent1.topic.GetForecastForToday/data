kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    triggerQueries:
      - get today's forecast
      - what's the weather like today?
      - tell me the forecast for today
      - what will be the weather today?
      - can you give me the forecast for today?
      - today's weather update
      - weather report for today
      - current weather conditions
      - is it going to rain today?
      - show me the weather forecast

  actions:
    - kind: Question
      id: AE67ED
      interruptionPolicy:
        allowInterruption: false
        interruptionTopicListFilter:
          kind: IncludeSelectedTopics
          allowedInterruptTopics:
            - alm_agent1.topic.StartOver

      unrecognizedPrompt: I am sorry, I did not recognize that city. Please try entering it again.
      variable: init:Topic.VarCity
      prompt: For which city do you wish to get the forecast for today?
      entity: CityPrebuiltEntity

    - kind: BeginDialog
      id: 6nSrZ2
      input:
        binding:
          Location: =Topic.VarCity

      dialog: alm_agent1.topic.MSNWeatherGetforecastfortoday
      output:
        binding:
          responses: Topic.responses
          units: Topic.units