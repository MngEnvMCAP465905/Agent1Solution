kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    triggerQueries:
      - current weather
      - weather update
      - what's the weather like?
      - check the weather
      - is it raining?
      - temperature right now
      - weather forecast today
      - tell me about the weather
      - weather conditions

  actions:
    - kind: Question
      id: question_cnv0EN
      interruptionPolicy:
        allowInterruption: true
        interruptionTopicListFilter:
          kind: IncludeSelectedTopics
          allowedInterruptTopics:
            - alm_agent1.topic.StartOver

      unrecognizedPrompt: I am sorry, I did not recognize that city. Please try entering it again.
      variable: init:Topic.VarCity
      prompt: For which city do you wish to get the current weather?
      entity: CityPrebuiltEntity

    - kind: Question
      id: question_KClgoT
      interruptionPolicy:
        allowInterruption: true

      variable: init:Topic.VarState
      prompt: For which state do you wish to get the current weather?
      entity: StatePrebuiltEntity

    - kind: BeginDialog
      id: Z2P8OL
      input:
        binding:
          Location: =Concatenate(Topic.VarCity, ", ", Topic.VarState)

      dialog: alm_agent1.topic.MSNWeatherGetcurrentweather
      output:
        binding:
          responses: Topic.responses
          units: Topic.units