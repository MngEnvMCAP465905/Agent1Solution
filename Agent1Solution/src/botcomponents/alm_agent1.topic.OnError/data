kind: AdaptiveDialog
beginDialog:
  kind: OnError
  id: main
  actions:
    - kind: SetVariable
      id: setVariable_timestamp
      variable: init:Topic.CurrentTime
      value: =Text(Now(), DateTimeFormat.UTC)

    - kind: SetVariable
      id: setVariable_KGlj5v
      variable: Topic.VarErrorMessage
      value: =System.Error.Message

    - kind: ConditionGroup
      id: condition_1
      conditions:
        - id: conditionItem_lcqI8b
          condition: =Topic.VarErrorMessage = "The connector ‘MSN Weather’ returned an HTTP error with code 404"
          actions:
            - kind: SendActivity
              id: sendActivity_pOaz66
              activity: There was an error when finding weather information. Most likely this is do to an unreconizable location entered.

      elseActions:
        - kind: ConditionGroup
          id: w5YDbW
          conditions:
            - id: P0Np4c
              condition: =System.Conversation.InTestMode = true
              actions:
                - kind: SendActivity
                  id: ilH7Qm
                  activity: |-
                    Error Message: {System.Error.Message}
                    Error Code: {System.Error.Code}    
                    Conversation Id: {System.Conversation.Id}    
                    Time (UTC): {Topic.CurrentTime} 

          elseActions:
            - kind: SendActivity
              id: 2U7r9p
              activity:
                text:
                  - |-
                    An error has occurred.
                    Error code: {System.Error.Code}
                    Conversation Id: {System.Conversation.Id}  
                    Time (UTC): {Topic.CurrentTime}  .
                speak:
                  - An error has occurred, please try again.

        - kind: LogCustomTelemetryEvent
          id: yDwGg8
          eventName: OnErrorLog
          properties: "={ErrorMessage: System.Error.Message, ErrorCode: System.Error.Code, TimeUTC: Topic.CurrentTime, ConversationId: System.Conversation.Id}"

    - kind: CancelAllDialogs
      id: NW7NyY