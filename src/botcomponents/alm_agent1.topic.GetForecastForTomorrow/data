kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    triggerQueries:
      - get forecast for tomorrow
      - weather forecast for tomorrow
      - what's the weather like tomorrow
      - tomorrow's weather forecast
      - tell me about tomorrow's weather
      - forecast for the next day

  actions:
    - kind: Question
      id: ceTUhe
      interruptionPolicy:
        allowInterruption: true
        interruptionTopicListFilter:
          kind: IncludeSelectedTopics
          allowedInterruptTopics:
            - alm_agent1.topic.StartOver

      unrecognizedPrompt: I am sorry, I did not recognize that city. Please try entering it again.
      variable: init:Topic.VarCity
      prompt: For which city do you wish to get the forecast for tomorrow?
      entity: CityPrebuiltEntity

    - kind: BeginDialog
      id: 1wTsNU
      input:
        binding:
          Location: =Topic.VarCity

      dialog: alm_agent1.topic.MSNWeatherGettheforecastfortomorrow
      output:
        binding:
          responses: Topic.responses
          units: Topic.units