    description: Units used for distance measurements.

  - propertyName: units.pressure
    name: Pressure Units
    description: Units used for pressure measurements.

  - propertyName: responses.daily.day.cap
    name: Daytime Conditions
    description: The daytime caption of weather conditions such as rainy, sunny, etc.

  - propertyName: responses.daily.night.cap
    name: Nighttime Conditions
    description: The nighttime caption of weather conditions such as rainy, sunny, etc.

